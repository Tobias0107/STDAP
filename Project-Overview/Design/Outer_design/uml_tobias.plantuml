This file describes the uml of the entire python package.

@startuml class UML

''''''''''''''''''''''''''''''''''''''
'''''' Defining all classes ''''''''''
''''''''''''''''''''''''''''''''''''''
' Main class (choose city also does the preprocessing / data_extraction)
class Main_class {
    Database data
    Network network

    void __init(csv, geopackage)
    Lst get_cities()
    Bool choose_city(city)
    DataFrame Simulate_transit_dist_on_trans(fraction, dem_grps, vis_opt)
    DataFrame Simulate_transit_dist_on_trans_range(range, dem_grps, vis_opt, prog_opt)
}

' Wrapper class for the entire database. For database structure, see outer_design.
' Data consists of the csv, geopackage, network nodes.
class Database {
    Duckdb connection
    Network network

    __init(csv, geopackage)
    Lst get_cities()
    set_city(city)
    load_network(Network)
    obtain_features()
    pre_process()
    create_pts_per_neighborhood()
    Pts obtain_generated_pts()
    remove_f_edges(fraction)
    link_busses()
    move_transit_minimal()
    move_transit_blank_slate()
    calculate_distances()
    get_dist_per_neighborhood()
    get_demographic_results()
}

' Wrapper for interacting with the network. All information about the nodes is stored
' in the database.
class Network {
    OSMnx graph_car_accessible
    OSMnx graph_pedestrian
    DataFrame NetworkFeatures
    void __init(city, store_in_file=True)
    DataFrames get_drive_network_df()
    DataFrame get_pedestrian_nodes_df()
    DataFrame get_distances_to_transit()
    DataFrame get_features()
    transform_edges(ebunch)
    add_edges_to_ped_network(ebunch)
}

class Settings {
    dataset_column_names
    dataset_nullstring
    dataset_delim
    dataset_decimal_separator
    neighborhood_distribution
    transit_max_edge_dist
    transit_max_pts_dist
    transit_max_move_dist
    max_dist_ped_transit
    min_distance_stops
    max_distance_stops
    max_stops_in_bus_route
    min_stops_in_bus_route
    amenity_to_pop_weight
    png_dpi
    colormap
    color_normalization
    legend_num_labels

    str Describe()
    DataFrame to_df()
}

protocol Functions {
    PoissonDiskDistribution()
}
protocol get_settings
protocol reset_settings

' Gui is separate from the Main_class and uses this main class to run the Gui.
protocol Gui

''''''''''''''''''''''''''''''''''''''
'''''' Defining relations ''''''''''''
''''''''''''''''''''''''''''''''''''''
Main_class::data --> Database : is
Main_class::network --> Network : is
Main_class ..|> get_settings : uses
Database ..|> get_settings : uses
Settings::neighborhood_distribution --> Functions::PoissonDiskDistribution : default
Settings <-- get_settings : creates
Settings <-- reset_settings : modifies

Database::network --> Network : is

Gui ..|> Main_class : uses

@enduml